# HireTrack Frontend — Environment Variables
#
# Copy this file to .env for local development.
# .env is gitignored — never commit real values.
#
# Per docs/ARCHITECTURE.md "Local Development Configuration":
#   - VITE_API_BASE_URL points directly to the backend (no dev-server proxy)
#   - Backend runs on http://localhost:8080 by default (port set in backend application.yml)

VITE_API_BASE_URL=http://localhost:8080
